# Porta do servidor Express
PORT=3000
NODE_ENV=development

# Supabase (Project Settings > API). A chave de servidor fica SOMENTE no backend.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=sua-chave-de-servidor-do-supabase

# JWT
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# SMTP para recuperação de senha
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=no-reply@example.com
EMAIL_PASS=troque-pela-senha-do-smtp

# Atrás de proxy reverso (Render, Fly, Vercel...) use 1 para req.ip ser o IP real do cliente.
# Localmente, deixe comentado.
# TRUST_PROXY=1
